{
  "name": "warmup",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "check-types": "npm run check-types --workspaces --if-present",
    "dev:web": "npm run dev --workspace web --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@warmup/config": "*",
    "typescript": "^6.0.3",
    "varlock": "1.23.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2",
    "minimatch": "^11.0.8",
    "deepmerge": "4.1.2"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "sharp": true,
    "protobufjs": true
  }
}
